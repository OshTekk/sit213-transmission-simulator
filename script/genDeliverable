#!/bin/sh
ARCHIVE_NAME="${1:-Pons-Weymeels-Touchais-Schaeffer.SIT213.Etape5}"

if [ -d "src" ]; then
    ROOT_DIR="."
elif [ -d "$(dirname "$0")/src" ]; then
    cd "$(dirname "$0")" || exit 1
elif [ -d "$(dirname "$0")/../src" ]; then
    cd "$(dirname "$0")/.." || exit 1
fi

if [ -f "script/cleanAll" ]; then
    sh script/cleanAll
else
    sh cleanAll
fi

cp script/compile compile
cp script/genDoc genDoc
cp script/cleanAll cleanAll
cp script/simulateur simulateur
cp script/runTests runTests
cp README.md readme

COPYFILE_DISABLE=1 tar --exclude='.DS_Store' --exclude='genDeliverable' --exclude='*.tar.gz' --exclude='.git*' --exclude='.idea*' --exclude='_xxx*' -czf "${ARCHIVE_NAME}.tar.gz" src bin docs tests compile genDoc cleanAll simulateur runTests readme mesures

rm -f compile genDoc cleanAll simulateur runTests readme

echo "Livrable genere : ${ARCHIVE_NAME}.tar.gz"
