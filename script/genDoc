#!/bin/sh
if [ -d "src" ]; then
    ROOT_DIR="."
elif [ -d "$(dirname "$0")/src" ]; then
    cd "$(dirname "$0")" || exit 1
elif [ -d "$(dirname "$0")/../src" ]; then
    cd "$(dirname "$0")/.." || exit 1
fi

mkdir -p docs
javadoc -Xdoclint:none -d docs -author -version -private -sourcepath src $(find src -name "*.java")
