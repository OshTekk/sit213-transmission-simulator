#!/bin/sh
if [ -d "src" ]; then
    ROOT_DIR="."
elif [ -d "$(dirname "$0")/src" ]; then
    cd "$(dirname "$0")" || exit 1
elif [ -d "$(dirname "$0")/../src" ]; then
    cd "$(dirname "$0")/.." || exit 1
fi

if [ -f "./simulateur" ]; then
    SIM="./simulateur"
elif [ -f "./script/simulateur" ]; then
    SIM="./script/simulateur"
else
    SIM="simulateur"
fi

echo "=== Tests JUnit ==="
if [ -d "tests" ]; then
    set -eu
    # Générer aussi la couverture lorsque des tests révèlent une anomalie.
    mvn -f tests/pom.xml clean test "$@" || statut=$?
    mvn -f tests/pom.xml jacoco:report "$@" || exit $?
else
    echo "Déploiement : tests non lancés"
fi

echo "=== Test 1: simulation par defaut ==="
sh "$SIM"

echo "=== Test 2: message impose ==="
sh "$SIM" -mess 1010101

echo "=== Test 3: longueur du message ==="
sh "$SIM" -mess 50

echo "=== Test 4: semence fixee ==="
sh "$SIM" -seed 42

echo "=== Fin des tests ==="
