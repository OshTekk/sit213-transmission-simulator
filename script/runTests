#!/bin/sh
BASEDIR=$(realpath "$(dirname $0)")

SIM="./simulateur"

echo "=== Test 1: simulation par defaut ==="
sh "$SIM"

echo "=== Test 2: message impose ==="
sh "$SIM" -mess 1010101

echo "=== Test 3: longueur du message ==="
sh "$SIM" -mess 50

echo "=== Test 4: semence fixee ==="
sh "$SIM" -seed 42

echo "=== Fin des tests ==="
