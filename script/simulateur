#!/bin/sh
if [ -d "src" ]; then
    ROOT_DIR="."
elif [ -d "$(dirname "$0")/src" ]; then
    cd "$(dirname "$0")" || exit 1
elif [ -d "$(dirname "$0")/../src" ]; then
    cd "$(dirname "$0")/.." || exit 1
fi

if [ ! -d "bin" ]; then
    echo "Le dossier bin n’existe pas. Executez le script compile avant."
elif [ -z "$(ls -A 'bin')" ]; then
    echo "Le dossier bin est vide. Executez le script compile avant."
    exit 1
fi

java -cp bin simulateur.Simulateur "$@"
